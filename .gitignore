# Real parameter values (client secret, CID, principal and subscription IDs) - keep local.
# Commit a parameters.example.bicepparam with placeholders instead.
*.bicepparam
!*.example.bicepparam

# Session history - contains pasted credentials
.remember/

# Local Claude Code settings and assistant history
.claude/

# Build output (regenerated by scripts/create-templatespec*.sh)
dist/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Portal screenshots contain real subscription/tenant IDs - keep local
docs/screenshots/

# internal-only: style sample and the CrowdSpace engineering page (never commit)
htmlexample/
crowdspace/

# Local env, archives, backups
.env
.envrc
*.bundle
*.tar.gz
_old*
