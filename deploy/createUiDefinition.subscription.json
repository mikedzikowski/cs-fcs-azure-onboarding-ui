            "type": "Microsoft.Common.DropDown",
            "label": "Falcon API region",
            "defaultValue": "US-1 (api.crowdstrike.com)",
            "toolTip": "CrowdStrike Falcon API endpoint.",
            "constraints": {
              "allowedValues": [
                {
                  "label": "US-1 (api.crowdstrike.com)",
                  "value": "api.crowdstrike.com"
                },
                {
                  "label": "US-2 (api.us-2.crowdstrike.com)",
                  "value": "api.us-2.crowdstrike.com"
                },
                {
                  "label": "EU-1 (api.eu-1.crowdstrike.com)",
                  "value": "api.eu-1.crowdstrike.com"
                },
                {
                  "label": "US-GOV-1 (api.laggar.gcw.crowdstrike.com)",
                  "value": "api.laggar.gcw.crowdstrike.com"
                }
              ],
              "required": false
            }
          },
          {
            "name": "accountType",
            "type": "Microsoft.Common.DropDown",
            "label": "Azure cloud environment",
            "defaultValue": "Commercial",
            "toolTip": "Azure cloud environment type.",
            "constraints": {
              "allowedValues": [
                {
                  "label": "Commercial",
                  "value": "commercial"
                },
                {
                  "label": "Government",
                  "value": "gov"
                }
              ]
            }
          }
        ]
      },
      {
        "name": "features",
        "label": "Features",
        "elements": [
          {
            "name": "enableRealTimeVisibility",
            "type": "Microsoft.Common.CheckBox",
            "label": "Enable real-time visibility and detection",
            "toolTip": "Monitor Azure Activity Logs and Entra ID logs."
          },
          {
            "name": "ehInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": "[steps('features').enableRealTimeVisibility]",
            "options": {
              "text": "By default CrowdStrike creates a new Event Hub namespace and hubs. To reuse an existing Event Hub, enable the option below and pick the namespace, hub, and consumer group.",
              "icon": "Info"
            }
          },
          {
            "name": "useExistingEventHub",
            "type": "Microsoft.Common.CheckBox",
            "label": "Use an existing Event Hub",
            "visible": "[steps('features').enableRealTimeVisibility]",
            "toolTip": "Reuse an existing Event Hub namespace/instance instead of creating new ones."
          },
          {
            "name": "existingEh",
            "type": "Microsoft.Common.Section",
            "label": "Existing Event Hub",
            "visible": "[and(steps('features').enableRealTimeVisibility, steps('features').useExistingEventHub)]",
            "elements": [
              {
                "name": "ehNamespace",
                "type": "Microsoft.Solutions.ResourceSelector",
                "label": "Event Hub namespace",
                "resourceType": "Microsoft.EventHub/namespaces",
                "toolTip": "Select the existing Event Hub namespace. Activity and Entra hubs are chosen from within it.",
                "options": {
                  "filter": {
                    "subscription": "all",
                    "location": "all"
                  }
                },
                "constraints": {
                  "required": "[steps('features').useExistingEventHub]"
                }
              },
              {
                "name": "hubsApi",
                "type": "Microsoft.Solutions.ArmApiControl",
                "request": {
                  "method": "GET",
                  "path": "[concat(coalesce(steps('features').existingEh.ehNamespace.id, ''), '/eventhubs?api-version=2024-01-01')]"
                },
                "condition": "[and(steps('features').enableRealTimeVisibility, steps('features').useExistingEventHub, not(empty(steps('features').existingEh.ehNamespace.id)))]"
              },
              {
                "name": "activityHubName",
                "type": "Microsoft.Common.DropDown",
                "label": "Activity Log Event Hub",
                "toolTip": "Event Hub instance that receives Azure Activity Logs.",
                "constraints": {
                  "allowedValues": "[map(coalesce(steps('features').existingEh.hubsApi.value, parse('[]')), (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]",
                  "required": "[steps('features').useExistingEventHub]"
                }
              },
              {
                "name": "activityCgApi",
                "type": "Microsoft.Solutions.ArmApiControl",
                "request": {
                  "method": "GET",
                  "path": "[concat(coalesce(steps('features').existingEh.ehNamespace.id, ''), '/eventhubs/', coalesce(steps('features').existingEh.activityHubName, ''), '/consumergroups?api-version=2024-01-01')]"
                },
                "condition": "[and(and(steps('features').enableRealTimeVisibility, steps('features').useExistingEventHub, not(empty(steps('features').existingEh.ehNamespace.id))), not(empty(steps('features').existingEh.activityHubName)))]"
              },
              {
                "name": "activityConsumerGroup",
                "type": "Microsoft.Common.DropDown",
                "label": "Activity Log consumer group",
                "defaultValue": "$Default",
                "toolTip": "Consumer group on the Activity Log Event Hub.",
                "constraints": {
                  "allowedValues": "[map(coalesce(steps('features').existingEh.activityCgApi.value, parse('[]')), (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]",
                  "required": "[steps('features').useExistingEventHub]"
                }
              },
              {
                "name": "entraHubName",
                "type": "Microsoft.Common.DropDown",
                "label": "Entra ID Log Event Hub",
                "toolTip": "Event Hub instance that receives Entra ID logs (can be the same as Activity).",
                "constraints": {
                  "allowedValues": "[map(coalesce(steps('features').existingEh.hubsApi.value, parse('[]')), (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]",
                  "required": "[steps('features').useExistingEventHub]"
                }
              },
              {
                "name": "entraCgApi",
                "type": "Microsoft.Solutions.ArmApiControl",
                "request": {
                  "method": "GET",
                  "path": "[concat(coalesce(steps('features').existingEh.ehNamespace.id, ''), '/eventhubs/', coalesce(steps('features').existingEh.entraHubName, ''), '/consumergroups?api-version=2024-01-01')]"
                },
                "condition": "[and(and(steps('features').enableRealTimeVisibility, steps('features').useExistingEventHub, not(empty(steps('features').existingEh.ehNamespace.id))), not(empty(steps('features').existingEh.entraHubName)))]"
              },
              {
                "name": "entraConsumerGroup",
                "type": "Microsoft.Common.DropDown",
                "label": "Entra ID Log consumer group",
                "defaultValue": "$Default",
                "toolTip": "Consumer group on the Entra ID Log Event Hub.",
                "constraints": {
                  "allowedValues": "[map(coalesce(steps('features').existingEh.entraCgApi.value, parse('[]')), (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]",
                  "required": "[steps('features').useExistingEventHub]"
                }
              }
            ]
          },
          {
            "name": "enableDspm",
            "type": "Microsoft.Common.CheckBox",
            "label": "Enable Data Security Posture Management (DSPM)",
            "toolTip": "Data discovery and classification across Azure data stores."
          },
          {
            "name": "enableVulnerabilityScanning",
            "type": "Microsoft.Common.CheckBox",
            "label": "Enable vulnerability scanning",
            "toolTip": "Agentless scanning of VMs and container images."
          },
          {
            "name": "scanningSection",
            "type": "Microsoft.Common.Section",
            "label": "Scanning configuration",
            "visible": "[or(steps('features').enableDspm, steps('features').enableVulnerabilityScanning)]",
            "elements": [
              {
                "name": "agentlessScanningLocations",
                "type": "Microsoft.Common.DropDown",
                "label": "Scanning regions",
                "multiselect": true,
                "toolTip": "Regions where agentless scanning is deployed.",
                "constraints": {
                  "allowedValues": [
                    {
                      "label": "East US",
                      "value": "eastus"
                    },
                    {
                      "label": "East US 2",
                      "value": "eastus2"
                    },
                    {
                      "label": "West US 2",
                      "value": "westus2"
                    },
                    {
                      "label": "West US 3",
                      "value": "westus3"
                    },
                    {
                      "label": "West Europe",
                      "value": "westeurope"
                    },
                    {
                      "label": "North Europe",
                      "value": "northeurope"
                    }
                  ],
                  "required": true
                }
              }
            ]
          },
          {
            "name": "falconIps",
            "type": "Microsoft.Common.Section",
            "label": "Falcon IP addresses",
            "visible": "[steps('features').enableRealTimeVisibility]",
            "elements": [
              {
                "name": "ipDocsUS1",
                "type": "Microsoft.Common.InfoBox",
                "visible": "[equals(steps('crowdStrikeConfig').falconApiFqdn, 'api.crowdstrike.com')]",
                "options": {
                  "text": "Enter the Falcon US-1 IP addresses from CrowdStrike's \"Allow CrowdStrike IP addresses\" page (opens the US-1 docs; Falcon login required). The Event Hub firewall denies everything else, so without them real-time visibility receives no logs.",
                  "uri": "https://docs.crowdstrike.com/access?ft:originId=ibc7ee4c",
                  "icon": "Info"
                }
              },
              {
                "name": "ipDocsUS2",
                "type": "Microsoft.Common.InfoBox",
                "visible": "[equals(steps('crowdStrikeConfig').falconApiFqdn, 'api.us-2.crowdstrike.com')]",
                "options": {
                  "text": "Enter the Falcon US-2 IP addresses from CrowdStrike's \"Allow CrowdStrike IP addresses\" page (opens the US-2 docs; Falcon login required). The Event Hub firewall denies everything else, so without them real-time visibility receives no logs.",
                  "uri": "https://docs.crowdstrike.com/access?ft:originId=a1f2fdef",
                  "icon": "Info"
                }
              },
              {
                "name": "ipDocsEU1",
                "type": "Microsoft.Common.InfoBox",
                "visible": "[equals(steps('crowdStrikeConfig').falconApiFqdn, 'api.eu-1.crowdstrike.com')]",
                "options": {
                  "text": "Enter the Falcon EU-1 IP addresses from CrowdStrike's \"Allow CrowdStrike IP addresses\" page (opens the EU-1 docs; Falcon login required). The Event Hub firewall denies everything else, so without them real-time visibility receives no logs.",
                  "uri": "https://docs.crowdstrike.com/access?ft:originId=yf3ab7b3",
                  "icon": "Info"
                }
              },
              {
                "name": "ipDocsOther",
                "type": "Microsoft.Common.InfoBox",
                "visible": "[not(or(equals(steps('crowdStrikeConfig').falconApiFqdn, 'api.crowdstrike.com'), equals(steps('crowdStrikeConfig').falconApiFqdn, 'api.us-2.crowdstrike.com'), equals(steps('crowdStrikeConfig').falconApiFqdn, 'api.eu-1.crowdstrike.com')))]",
                "options": {
                  "text": "Enter the Falcon IP addresses for your Falcon cloud from CrowdStrike's \"Allow CrowdStrike IP addresses\" documentation page (Falcon login required). The Event Hub firewall denies everything else.",
                  "icon": "Info"
                }
              },
              {
                "name": "falconIpAddresses",
                "type": "Microsoft.Common.TextBox",
                "label": "Falcon IP addresses (comma-separated)",
                "placeholder": "e.g. 192.0.2.10, 192.0.2.11",
                "toolTip": "CrowdStrike Falcon IP addresses allowed through the Event Hub firewall.",
                "constraints": {
                  "required": "[steps('features').enableRealTimeVisibility]",
                  "validations": [
                    {
                      "regex": "^\\s*(\\d{1,3}\\.){3}\\d{1,3}(/\\d{1,2})?(\\s*,\\s*(\\d{1,3}\\.){3}\\d{1,3}(/\\d{1,2})?)*\\s*$",
                      "message": "Comma-separated IPv4 addresses (optionally /CIDR), e.g. 192.0.2.10, 192.0.2.11."
                    }
                  ]
                }
              }
            ]
          },
          {
            "name": "falconApi",
            "type": "Microsoft.Common.Section",
            "label": "Falcon API credentials",
            "visible": "[or(steps('features').enableRealTimeVisibility, steps('features').enableDspm, steps('features').enableVulnerabilityScanning)]",
            "elements": [
              {
                "name": "falconApiInfo",
                "type": "Microsoft.Common.InfoBox",
                "visible": true,
                "options": {
                  "text": "Real-time visibility, DSPM and vulnerability scanning report to Falcon, so a Falcon API client ID and secret are required.",
                  "icon": "Info"
                }
              },
              {
                "name": "falconClientId",
                "type": "Microsoft.Common.TextBox",
                "label": "Falcon API client ID",
                "defaultValue": "",
                "toolTip": "Client ID for the CrowdStrike Falcon API.",
                "constraints": {
                  "required": "[or(steps('features').enableRealTimeVisibility, steps('features').enableDspm, steps('features').enableVulnerabilityScanning)]"
                }
              },
              {
                "name": "falconClientSecret",
                "type": "Microsoft.Common.PasswordBox",
                "label": {
                  "password": "Falcon API client secret",
                  "confirmPassword": "Confirm client secret"
                },
                "toolTip": "Client secret for the CrowdStrike Falcon API.",
                "constraints": {
                  "required": "[or(steps('features').enableRealTimeVisibility, steps('features').enableDspm, steps('features').enableVulnerabilityScanning)]"
                },
                "options": {
                  "hideConfirmation": false
                }
              }
            ]
          }
        ]
      },
      {
        "name": "advanced",
        "label": "Advanced",
        "elements": [
          {
            "name": "env",
            "type": "Microsoft.Common.DropDown",
            "label": "Environment",
            "defaultValue": "Production",
            "toolTip": "Environment label for naming and tagging.",
            "constraints": {
              "allowedValues": [
                {
                  "label": "Production",
                  "value": "prod"
                },
                {
                  "label": "Staging",
                  "value": "stag"
                },
                {
                  "label": "Development",
                  "value": "dev"
                },
                {
                  "label": "Test",
                  "value": "test"
                }
              ]
            }
          },
          {
            "name": "resourceNamePrefix",
            "type": "Microsoft.Common.TextBox",
            "label": "Resource name prefix",
            "defaultValue": "",
            "toolTip": "Optional prefix (max 10 chars combined with suffix).",
            "constraints": {
              "required": false,
              "validations": [
                {
                  "regex": "^[a-zA-Z0-9\\-_]{0,10}$",
                  "message": "0-10 chars: letters, numbers, hyphens, underscores."
                }
              ]
            }
          },
          {
            "name": "resourceNameSuffix",
            "type": "Microsoft.Common.TextBox",
            "label": "Resource name suffix",
            "defaultValue": "",
            "toolTip": "Optional suffix (max 10 chars combined with prefix).",
            "constraints": {
              "required": false,
              "validations": [
                {
                  "regex": "^[a-zA-Z0-9\\-_]{0,10}$",
                  "message": "0-10 chars: letters, numbers, hyphens, underscores."
                }
              ]
            }
          },
          {
            "name": "isInitialRegistration",
            "type": "Microsoft.Common.CheckBox",
            "label": "Initial registration (uncheck to update an existing integration)",
            "defaultValue": true
          }
        ]
      }
    ],
    "outputs": {
      "csInfraSubscriptionId": "[subscription().subscriptionId]",
      "subscriptionIds": "[if(empty(steps('scope').subscriptionIds), parse('[]'), filter(split(replace(steps('scope').subscriptionIds, ' ', ''), ','), (s) => not(empty(s))))]",
      "location": "[location()]",
      "azurePrincipalId": "[steps('scope').azurePrincipalId]",
      "falconApiFqdn": "[steps('crowdStrikeConfig').falconApiFqdn]",
      "falconClientId": "[if(or(steps('features').enableRealTimeVisibility, steps('features').enableDspm, steps('features').enableVulnerabilityScanning), steps('features').falconApi.falconClientId, '')]",
      "falconClientSecret": "[if(or(steps('features').enableRealTimeVisibility, steps('features').enableDspm, steps('features').enableVulnerabilityScanning), steps('features').falconApi.falconClientSecret, '')]",
      "accountType": "[steps('crowdStrikeConfig').accountType]",
      "enableRealTimeVisibility": "[steps('features').enableRealTimeVisibility]",
      "logIngestionSettings": {
        "activityLogSettings": {
          "enabled": "[steps('features').enableRealTimeVisibility]",
          "deployRemediationPolicy": true,
          "existingEventhub": {
            "use": "[coalesce(steps('features').useExistingEventHub, false)]",
            "subscriptionId": "[first(skip(split(coalesce(steps('features').existingEh.ehNamespace.id, '//////'), '/'), 2))]",
            "resourceGroupName": "[first(skip(split(coalesce(steps('features').existingEh.ehNamespace.id, '//////'), '/'), 4))]",
            "namespaceName": "[coalesce(steps('features').existingEh.ehNamespace.name, '')]",
            "name": "[coalesce(steps('features').existingEh.activityHubName, '')]",
            "consumerGroupName": "[coalesce(steps('features').existingEh.activityConsumerGroup, '')]"
          }
        },
        "entraIdLogSettings": {
          "enabled": "[steps('features').enableRealTimeVisibility]",
          "existingEventhub": {
            "use": "[coalesce(steps('features').useExistingEventHub, false)]",
            "subscriptionId": "[first(skip(split(coalesce(steps('features').existingEh.ehNamespace.id, '//////'), '/'), 2))]",
            "resourceGroupName": "[first(skip(split(coalesce(steps('features').existingEh.ehNamespace.id, '//////'), '/'), 4))]",
            "namespaceName": "[coalesce(steps('features').existingEh.ehNamespace.name, '')]",
            "name": "[coalesce(steps('features').existingEh.entraHubName, '')]",
            "consumerGroupName": "[coalesce(steps('features').existingEh.entraConsumerGroup, '')]"
          }
        }
      },
      "enableDspm": "[steps('features').enableDspm]",
      "enableVulnerabilityScanning": "[steps('features').enableVulnerabilityScanning]",
      "agentlessScanningLocations": "[if(or(steps('features').enableDspm, steps('features').enableVulnerabilityScanning), steps('features').scanningSection.agentlessScanningLocations, parse('[]'))]",
      "resourceNamePrefix": "[steps('advanced').resourceNamePrefix]",
      "resourceNameSuffix": "[steps('advanced').resourceNameSuffix]",
      "env": "[steps('advanced').env]",
      "isInitialRegistration": "[steps('advanced').isInitialRegistration]",
      "falconIpAddresses": "[if(steps('features').enableRealTimeVisibility, filter(split(replace(coalesce(steps('features').falconIps.falconIpAddresses, ''), ' ', ''), ','), (s) => not(empty(s))), parse('[]'))]"
    }
  }
}
