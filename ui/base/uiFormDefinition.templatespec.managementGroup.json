{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json#",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "CrowdStrike Falcon Cloud Security (Management Group)",
      "steps": [
        {
          "name": "basics",
          "label": "Basics",
          "elements": [
            {
              "name": "intro",
              "type": "Microsoft.Common.InfoBox",
              "visible": true,
              "options": {
                "icon": "Info",
                "text": "Configure CrowdStrike Falcon Cloud Security at management-group scope. All subscriptions under the selected management group are discovered and onboarded. The deployment stack is created at the management group you specify."
              }
            },
            {
              "name": "managementGroupId",
              "type": "Microsoft.Common.TextBox",
              "label": "Management group ID",
              "defaultValue": "",
              "toolTip": "The target management group ID (not display name). The deployment stack is created here and all child subscriptions are onboarded.",
              "constraints": {
                "required": true,
                "validations": [
                  {
                    "regex": "^[a-zA-Z0-9\\-_\\.\\(\\)]{1,90}$",
                    "message": "Enter a valid management group ID."
                  }
                ]
              }
            },
            {
              "name": "region",
              "type": "Microsoft.Common.DropDown",
              "label": "Region",
              "defaultValue": "West US 2",
              "toolTip": "Azure region for global resources and the deployment stack.",
              "constraints": {
                "allowedValues": [
                  { "label": "East US", "value": "eastus" },
                  { "label": "East US 2", "value": "eastus2" },
                  { "label": "West US", "value": "westus" },
                  { "label": "West US 2", "value": "westus2" },
                  { "label": "West US 3", "value": "westus3" },
                  { "label": "Central US", "value": "centralus" },
                  { "label": "West Europe", "value": "westeurope" },
                  { "label": "North Europe", "value": "northeurope" },
                  { "label": "UK South", "value": "uksouth" },
                  { "label": "Australia East", "value": "australiaeast" },
                  { "label": "Southeast Asia", "value": "southeastasia" }
                ],
                "required": true
              }
            },
            {
              "name": "csInfraSubscriptionId",
              "type": "Microsoft.Common.TextBox",
              "label": "Infrastructure subscription ID",
              "defaultValue": "",
              "toolTip": "Subscription ID that hosts CrowdStrike infrastructure (Event Hubs, Key Vault, etc.).",
              "constraints": {
                "required": true,
                "validations": [
                  {
                    "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                    "message": "Must be a valid subscription GUID."
                  }
                ]
              }
            },
            {
              "name": "azurePrincipalId",
              "type": "Microsoft.Common.TextBox",
              "label": "CrowdStrike service principal ID",
              "defaultValue": "",
              "toolTip": "Object ID of the CrowdStrike application registered in your Entra ID.",
              "constraints": {
                "required": true,
                "validations": [
                  {
                    "regex": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                    "message": "Must be a valid GUID."
                  }
                ]
              }
            }
          ]
        },
        {
          "name": "crowdStrikeConfig",
          "label": "CrowdStrike",
          "elements": [
            {
              "name": "falconApiFqdn",
              "type": "Microsoft.Common.DropDown",
              "label": "Falcon API region",
              "defaultValue": "US-1 (api.crowdstrike.com)",
              "toolTip": "CrowdStrike Falcon API endpoint.",
              "constraints": {
                "allowedValues": [
                  { "label": "US-1 (api.crowdstrike.com)", "value": "api.crowdstrike.com" },
                  { "label": "US-2 (api.us-2.crowdstrike.com)", "value": "api.us-2.crowdstrike.com" },
                  { "label": "EU-1 (api.eu-1.crowdstrike.com)", "value": "api.eu-1.crowdstrike.com" },
                  { "label": "US-GOV-1 (api.laggar.gcw.crowdstrike.com)", "value": "api.laggar.gcw.crowdstrike.com" }
                ],
                "required": false
              }
            },
            {
              "name": "accountType",
              "type": "Microsoft.Common.DropDown",
              "label": "Azure cloud environment",
              "defaultValue": "Commercial",
              "toolTip": "Azure cloud environment type.",
              "constraints": {
                "allowedValues": [
                  { "label": "Commercial", "value": "commercial" },
                  { "label": "Government", "value": "gov" }
                ]
              }
            },
            {
              "name": "credsInfo",
              "type": "Microsoft.Common.InfoBox",
              "visible": true,
              "options": {
                "icon": "Warning",
                "text": "API credentials are required only if you enable real-time visibility or scanning below."
              }
            },
            {
              "name": "falconClientId",
              "type": "Microsoft.Common.TextBox",
              "label": "Falcon API client ID",
              "defaultValue": "",
              "toolTip": "Client ID for the CrowdStrike Falcon API.",
              "constraints": {
                "required": false
              }
            },
            {
              "name": "falconClientSecret",
              "type": "Microsoft.Common.PasswordBox",
              "label": {
                "password": "Falcon API client secret",
                "confirmPassword": "Confirm client secret"
              },
              "toolTip": "Client secret for the CrowdStrike Falcon API.",
              "constraints": {
                "required": false
              },
              "options": {
                "hideConfirmation": false
              }
            }
          ]
        },
        {
          "name": "features",
          "label": "Features",
          "elements": [
            {
              "name": "enableRealTimeVisibility",
              "type": "Microsoft.Common.CheckBox",
              "label": "Enable real-time visibility and detection",
              "toolTip": "Monitor Azure Activity Logs and Entra ID logs."
            },
            {
              "name": "enableDspm",
              "type": "Microsoft.Common.CheckBox",
              "label": "Enable Data Security Posture Management (DSPM)",
              "toolTip": "Data discovery and classification across Azure data stores."
            },
            {
              "name": "enableVulnerabilityScanning",
              "type": "Microsoft.Common.CheckBox",
              "label": "Enable vulnerability scanning",
              "toolTip": "Agentless scanning of VMs and container images."
            },
            {
              "name": "scanningSection",
              "type": "Microsoft.Common.Section",
              "label": "Scanning configuration",
              "visible": "[or(steps('features').enableDspm, steps('features').enableVulnerabilityScanning)]",
              "elements": [
                {
                  "name": "agentlessScanningLocations",
                  "type": "Microsoft.Common.DropDown",
                  "label": "Scanning regions",
                  "multiselect": true,
                  "toolTip": "Regions where agentless scanning is deployed.",
                  "constraints": {
                    "allowedValues": [
                      { "label": "East US", "value": "eastus" },
                      { "label": "East US 2", "value": "eastus2" },
                      { "label": "West US 2", "value": "westus2" },
                      { "label": "West US 3", "value": "westus3" },
                      { "label": "West Europe", "value": "westeurope" },
                      { "label": "North Europe", "value": "northeurope" }
                    ],
                    "required": true
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "advanced",
          "label": "Advanced",
          "elements": [
            {
              "name": "env",
              "type": "Microsoft.Common.DropDown",
              "label": "Environment",
              "defaultValue": "Production",
              "toolTip": "Environment label for naming and tagging.",
              "constraints": {
                "allowedValues": [
                  { "label": "Production", "value": "prod" },
                  { "label": "Staging", "value": "stag" },
                  { "label": "Development", "value": "dev" },
                  { "label": "Test", "value": "test" }
                ]
              }
            },
            {
              "name": "resourceNamePrefix",
              "type": "Microsoft.Common.TextBox",
              "label": "Resource name prefix",
              "defaultValue": "",
              "toolTip": "Optional prefix (max 10 chars combined with suffix).",
              "constraints": {
                "required": false,
                "validations": [
                  { "regex": "^[a-zA-Z0-9\\-_]{0,10}$", "message": "0-10 chars: letters, numbers, hyphens, underscores." }
                ]
              }
            },
            {
              "name": "resourceNameSuffix",
              "type": "Microsoft.Common.TextBox",
              "label": "Resource name suffix",
              "defaultValue": "",
              "toolTip": "Optional suffix (max 10 chars combined with prefix).",
              "constraints": {
                "required": false,
                "validations": [
                  { "regex": "^[a-zA-Z0-9\\-_]{0,10}$", "message": "0-10 chars: letters, numbers, hyphens, underscores." }
                ]
              }
            },
            {
              "name": "isInitialRegistration",
              "type": "Microsoft.Common.CheckBox",
              "label": "Initial registration (uncheck to update an existing integration)",
              "defaultValue": true
            }
          ]
        }
      ]
    },
    "outputs": {
      "kind": "ManagementGroup",
      "managementGroupId": "[steps('basics').managementGroupId]",
      "location": "[steps('basics').region]",
      "parameters": {
        "managementGroupIds": "[parse(concat('[\"', steps('basics').managementGroupId, '\"]'))]",
        "subscriptionIds": "[parse('[]')]",
        "csInfraSubscriptionId": "[steps('basics').csInfraSubscriptionId]",
        "location": "[steps('basics').region]",
        "azurePrincipalId": "[steps('basics').azurePrincipalId]",
        "falconApiFqdn": "[steps('crowdStrikeConfig').falconApiFqdn]",
        "falconClientId": "[steps('crowdStrikeConfig').falconClientId]",
        "falconClientSecret": "[steps('crowdStrikeConfig').falconClientSecret]",
        "accountType": "[steps('crowdStrikeConfig').accountType]",
        "enableRealTimeVisibility": "[steps('features').enableRealTimeVisibility]",
        "enableDspm": "[steps('features').enableDspm]",
        "enableVulnerabilityScanning": "[steps('features').enableVulnerabilityScanning]",
        "agentlessScanningLocations": "[if(or(steps('features').enableDspm, steps('features').enableVulnerabilityScanning), steps('features').scanningSection.agentlessScanningLocations, parse('[]'))]",
        "resourceNamePrefix": "[steps('advanced').resourceNamePrefix]",
        "resourceNameSuffix": "[steps('advanced').resourceNameSuffix]",
        "env": "[steps('advanced').env]",
        "isInitialRegistration": "[steps('advanced').isInitialRegistration]"
      }
    }
  }
}